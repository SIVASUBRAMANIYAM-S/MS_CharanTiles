EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-publishable-or-anon-key>

# Database URL — used only for running migrations via: npx supabase db push --db-url "$SUPABASE_DB_URL"
# URL-encode special characters in the password (e.g. @ -> %40).
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
